# Copy this file to .env and fill in your own values.
# Never commit the real .env file — it's already in .gitignore.

# Google Gemini API key, used for AI recommendations + monthly reports.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Resend API key, used for email alerts to gym staff (optional for the demo).
# https://resend.com
RESEND_API_KEY=

# Who receives email alerts / monthly reports
GYM_STAFF_EMAIL=you@example.com

# "From" address used when sending via Resend
ALERT_FROM_EMAIL=onboarding@resend.dev
